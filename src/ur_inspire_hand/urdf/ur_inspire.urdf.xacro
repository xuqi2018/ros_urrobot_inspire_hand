<?xml version="1.0"?>
<!--
  ============================================================================
  ur_inspire_hand.urdf.xacro
  ============================================================================
  Combined robot: Universal Robots UR arm (default ur5) + Inspire Robots
  (因时机器人) RH56DFX right dexterous hand mounted on the tool flange.

  Kinematic chain (human-like: shoulder / arm / elbow / forearm / wrist / hand):
    world -> base_link (shoulder)
          -> shoulder_link -> upper_arm_link (arm)
          -> forearm_link (elbow)
          -> wrist_1/2/3_link (wrist)
          -> flange -> tool0
          -> inspire_hand_base -> r_hand_base (palm) -> fingers

  Usage (after colcon build):
    ros2 launch ur_inspire_hand ur_inspire_gazebo.launch.py
    ros2 launch ur_inspire_hand ur_inspire_gazebo.launch.py

  The UR arm is generated by the official ur_macro.xacro from the
  Universal_Robots_ROS2_Description repository (humble branch). The Inspire
  hand comes from urdf/inc/inspire_hand.urdf.xacro (see its header for
  provenance). The official URDF ends at the plain tool0 flange, so the
  hand is mounted there directly (this replaces any end effector such as a
  suction gripper with the Inspire dexterous hand).

  ros2_control: a single system block lists all 18 joints (6 arm + 6 actuated
  hand + 6 mimic hand joints). Mimic joints are driven automatically by
  gazebo_ros2_control (multiplier) whenever their actuated joint is commanded.
  ============================================================================
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur_inspire_hand">

  <!-- ======================= launch arguments ======================= -->
  <!-- robot name (also used as ros2_control prefix and Gazebo model name) -->
  <xacro:arg name="name" default="ur_inspire_hand"/>
  <!-- tf prefix for the arm frames (hand frames are never prefixed) -->
  <xacro:arg name="tf_prefix" default=""/>

  <!-- UR arm configuration files (defaults point into the ur_description package) -->
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/ur5/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/ur5/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/ur5/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/ur5/visual_parameters.yaml"/>
  <xacro:arg name="initial_positions_file" default="$(find ur_description)/config/initial_positions.yaml"/>
  <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>

  <!-- Inspire hand mounting (relative to the UR tool0 frame).
       Default: hand wrist plate exactly at tool0, fingers pointing forward
       (+Z of tool0), index finger up, palm facing right.
       Tune these if you use a different bracket or want another orientation. -->
  <xacro:arg name="hand_xyz" default="-0.001867 -0.000596 0.034255"/>
  <xacro:arg name="hand_rpy" default="1.5707963267948966 0 3.141592653589793"/>
  <!-- set to false to get the bare UR arm without the hand -->
  <xacro:arg name="use_hand" default="true"/>

  <!-- ======================= includes ======================= -->
  <!-- official UR arm macro (humble branch of Universal_Robots_ROS2_Description) -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <!-- Inspire RH56DFX right hand (meshes in this package's meshes/ folder) -->
  <xacro:include filename="$(find ur_inspire_hand)/urdf/inc/inspire_hand.urdf.xacro"/>

  <!-- ======================= world root ======================= -->
  <!-- Fixed root link; the arm base is welded to it. Gazebo/RViz treat this
       as the model root frame. -->
  <link name="world"/>

  <!-- ======================= UR arm ======================= -->
  <!-- generate_ros2_control_tag:=false -> we define one combined ros2_control
       block below instead of the macro's built-in one.
       sim_gazebo:=true -> mesh references are emitted as absolute file://
       paths (required by Gazebo). -->
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    generate_ros2_control_tag="false"
    sim_gazebo="true"
    initial_positions="${xacro.load_yaml(initial_positions_file)}"
    >
    <origin xyz="0 0 0" rpy="0 0 0"/>          <!-- position robot in the world -->
  </xacro:ur_robot>

  <!-- ======================= Inspire hand ======================= -->
  <!-- The hand's root link (inspire_hand_base) is mounted on the UR tool0
       frame. This is the "end effector swap": whatever was on the flange
       before (suction gripper / tool) is replaced by the dexterous hand. -->
  <xacro:if value="$(arg use_hand)">
    <joint name="tool0_inspire_hand_joint" type="fixed">
      <origin xyz="$(arg hand_xyz)" rpy="$(arg hand_rpy)"/>
      <parent link="$(arg tf_prefix)tool0"/>
      <child link="inspire_hand_base"/>
    </joint>
  </xacro:if>

  <!-- ======================= ros2_control ======================= -->
  <!-- One system block for the whole robot. The hardware plugin
       gazebo_ros2_control/GazeboSystem is provided by the gazebo_ros2_control
       Gazebo plugin below. -->
  <ros2_control name="ur_inspire_system" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <!-- ============ UR arm joints ============ -->
    <joint name="$(arg tf_prefix)shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${xacro.load_yaml(initial_positions_file)['shoulder_pan_joint']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="$(arg tf_prefix)shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${xacro.load_yaml(initial_positions_file)['shoulder_lift_joint']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="$(arg tf_prefix)elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${xacro.load_yaml(initial_positions_file)['elbow_joint']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="$(arg tf_prefix)wrist_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${xacro.load_yaml(initial_positions_file)['wrist_1_joint']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="$(arg tf_prefix)wrist_2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${xacro.load_yaml(initial_positions_file)['wrist_2_joint']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="$(arg tf_prefix)wrist_3_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${xacro.load_yaml(initial_positions_file)['wrist_3_joint']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- ============ Inspire hand: actuated joints (6 DOF) ============ -->
    <joint name="right_thumb_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_thumb_2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_index_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_middle_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_ring_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_little_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- ============ Inspire hand: mimic joints (follow the actuated ones) ============
         gazebo_ros2_control reads <param name="mimic"> and <param name="multiplier">
         and drives these joints automatically (multiplier * actuated command).
         Note: the URDF <mimic> offset values are NOT applied by
         gazebo_ros2_control (only the multiplier), see hand URDF header. -->
    <joint name="right_thumb_3_joint">
      <param name="mimic">right_thumb_2_joint</param>
      <param name="multiplier">1.1425</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_thumb_4_joint">
      <param name="mimic">right_thumb_3_joint</param>
      <param name="multiplier">0.7508</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_index_2_joint">
      <param name="mimic">right_index_1_joint</param>
      <param name="multiplier">1.1169</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_middle_2_joint">
      <param name="mimic">right_middle_1_joint</param>
      <param name="multiplier">1.1169</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_ring_2_joint">
      <param name="mimic">right_ring_1_joint</param>
      <param name="multiplier">1.1169</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_little_2_joint">
      <param name="mimic">right_little_1_joint</param>
      <param name="multiplier">1.1169</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ======================= Gazebo plugin ======================= -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find ur_inspire_hand)/config/ur_inspire_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
